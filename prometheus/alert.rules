groups:
  - name: liveness
    rules:
      - alert: NoCommandsProcessed
        expr: (sum(rate(bot_slash_commands_executed[5m])) + sum(rate(bot_commands_executed[5m]))) == 0
        for: 30m
        labels:
          severity: critical
        annotations:
          summary: "fmbot has processed no commands for 30 minutes"
          description: "Combined rate of bot_slash_commands_executed and bot_commands_executed has been zero for 30 minutes. The bot is likely down or unable to handle interactions."
